{
  "type": "اناشيد",
  "name": "قصيدة ليس الغريب",
  "verses": 71,
  "category": "أنشيدة",
  "generated_by": "groq_whisper",
  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 11.22,
      "text": "ليس الغريب غريب الشام واليمن"
    },
    {
      "id": 1,
      "start": 11.22,
      "end": 23.02,
      "text": "إن الغريب غريب اللحد والكفن"
    },
    {
      "id": 2,
      "start": 23.02,
      "end": 35.78,
      "text": "إن الغريب له حق لغربته"
    },
    {
      "id": 3,
      "start": 35.78,
      "end": 44.74,
      "text": "على المقيمين في الأوطان والسكن"
    },
    {
      "id": 4,
      "start": 44.74,
      "end": 56.12,
      "text": "لا تنهرن غريبا حال غربته"
    },
    {
      "id": 5,
      "start": 56.12,
      "end": 66.12,
      "text": "الدهر ينهره بالذل والمحن"
    },
    {
      "id": 6,
      "start": 66.12,
      "end": 78.64,
      "text": "سفري بعيد وزادي لن يبلغني"
    },
    {
      "id": 7,
      "start": 78.64,
      "end": 89.06,
      "text": "وقوتي ضعفت والموت يطلبني"
    },
    {
      "id": 8,
      "start": 89.06,
      "end": 108.84,
      "text": "ولي بقايا ذنوب لست أعلمها الله يعلمها في السر والعلن"
    },
    {
      "id": 9,
      "start": 108.84,
      "end": 119.84,
      "text": "ما أحلم الله عني حيث أمهرني"
    },
    {
      "id": 10,
      "start": 120.74,
      "end": 129.84,
      "text": "وقد تماديت في ذنبي ويسترني"
    },
    {
      "id": 11,
      "start": 129.84,
      "end": 150.78,
      "text": "تمر ساعات أيامي بلا ندم ولا بكاء ولا خوف ولا حزن"
    },
    {
      "id": 12,
      "start": 150.78,
      "end": 168.78,
      "text": "أنا الذي أولق الأبواب مجتهدا على المعاصي وعين الله تمرني"
    },
    {
      "id": 13,
      "start": 168.78,
      "end": 179.06,
      "text": "يا زلة كتبت في غفلة ذهبت"
    },
    {
      "id": 14,
      "start": 179.06,
      "end": 187.78,
      "text": "يا حسرة بقيت في القلب تحرقني"
    },
    {
      "id": 15,
      "start": 187.78,
      "end": 197.78,
      "text": "دعني أنوح على نفسي وأندبها"
    },
    {
      "id": 16,
      "start": 197.78,
      "end": 206.6,
      "text": "وأقطع الدهر بالتذكير والحزن"
    },
    {
      "id": 17,
      "start": 206.6,
      "end": 216.78,
      "text": "دع عنك عزني يا من كان يعذلني"
    },
    {
      "id": 18,
      "start": 216.78,
      "end": 226.24,
      "text": "لو كنت تعلم ما بي كنت تعذرني"
    },
    {
      "id": 20,
      "start": 258.193,
      "end": 269.213,
      "text": "على الفراش وأيديهم تقلبني"
    },
    {
      "id": 21,
      "start": 269.213,
      "end": 288.173,
      "text": "وقد تجمع حولي من ينوح ومن يبكي علي وينعاني وينذبني"
    },
    {
      "id": 22,
      "start": 288.173,
      "end": 308.593,
      "text": "وقد أتوا بقبيب كي يعالجني ولم أرى الطب هذا اليوم ينفعني"
    },
    {
      "id": 23,
      "start": 308.593,
      "end": 327.593,
      "text": "واشتد نزعي وصار الموت يجذبها من كل علق بلا رق ولا هوني"
    },
    {
      "id": 24,
      "start": 327.593,
      "end": 348.873,
      "text": "واستخرج الروح مني في تغرغرها وصار لي قميرا حين غرغرني"
    },
    {
      "id": 25,
      "start": 348.873,
      "end": 368.693,
      "text": "وغمضون وراح الكل وانصرفوا بعد الإياس وجبدوا في شر الكفن"
    },
    {
      "id": 26,
      "start": 368.693,
      "end": 388.093,
      "text": "وقام من كان حب الناس في عجل نحو المغسل يأتيني يغسلني"
    },
    {
      "id": 27,
      "start": 388.093,
      "end": 398.313,
      "text": "وقال يا قوم نبغي غاسلا حذقا"
    },
    {
      "id": 28,
      "start": 398.313,
      "end": 407.993,
      "text": "حرا أديبا أريبا عارفا فطني"
    },
    {
      "id": 29,
      "start": 407.993,
      "end": 419.433,
      "text": "فجاني رجل منهم فجردني"
    },
    {
      "id": 30,
      "start": 419.433,
      "end": 427.773,
      "text": "من الثياب وأعراني وأفردني"
    },
    {
      "id": 31,
      "start": 427.773,
      "end": 436.773,
      "text": "وأودعوني على الألواح منطرحا"
    },
    {
      "id": 32,
      "start": 437.513,
      "end": 446.773,
      "text": "وصار فوقي خرير الماء ينظفني"
    },
    {
      "id": 33,
      "start": 446.773,
      "end": 470.133,
      "text": "وأسكب الماء من فرقي وغسلني غسلا ثلاثا ونادى القوم بالكفن"
    },
    {
      "id": 35,
      "start": 487.266,
      "end": 496.846,
      "text": "وأخرجوني من الدنيا فواء سفا"
    },
    {
      "id": 36,
      "start": 496.846,
      "end": 505.786,
      "text": "على رحيل بلا زاد يبلغني"
    },
    {
      "id": 37,
      "start": 505.786,
      "end": 515.786,
      "text": "وحملوني على الأكتاف أربعة من الرجال"
    },
    {
      "id": 38,
      "start": 516.426,
      "end": 522.586,
      "text": "وخلفي من يشيعني"
    },
    {
      "id": 39,
      "start": 522.586,
      "end": 540.926,
      "text": "وقدموني للمحراب وانصرفوا خلف الإمام فصلى ثم ودعني"
    },
    {
      "id": 40,
      "start": 540.926,
      "end": 559.186,
      "text": "صلوا علي صلاة لا ركوع لها ولا سجود لعل الله يرحمني"
    },
    {
      "id": 41,
      "start": 559.186,
      "end": 578.386,
      "text": "وأنزلوني إلى قبري على مهل وقدموا واحدا منهم يلاحظني"
    },
    {
      "id": 42,
      "start": 578.386,
      "end": 589.386,
      "text": "وكشف الثوب عن وجهه لينظرني"
    },
    {
      "id": 43,
      "start": 589.386,
      "end": 598.386,
      "text": "وأسكب الدمع من عيني أغرقني"
    },
    {
      "id": 44,
      "start": 598.386,
      "end": 616.386,
      "text": "فقام محترما بالعزم مشتملا وصفف اللبن من فوقي وفارقني"
    },
    {
      "id": 45,
      "start": 616.386,
      "end": 635.386,
      "text": "وقال هلوا عليه التوبة واغتنموا حسن الثواب من الرحمن ذي المنني"
    },
    {
      "id": 46,
      "start": 635.386,
      "end": 654.386,
      "text": "في ظلمة القبر لا أم هناك ولا أب شفيق ولا أخي أنسني"
    },
    {
      "id": 47,
      "start": 654.386,
      "end": 671.386,
      "text": "فريد وحيد القبر يا سفا على الفراق بلا عمل يزودني"
    },
    {
      "id": 48,
      "start": 671.386,
      "end": 691.386,
      "text": "وهالني صورة في العين إذ نظرت من هول ما طلع ما قد كان أبهشني"
    },
    {
      "id": 49,
      "start": 691.386,
      "end": 701.386,
      "text": "من منكر ونكير ما أقول لهم"
    },
    {
      "id": 50,
      "start": 701.986,
      "end": 711.386,
      "text": "قد هالني أمرهم جدا فأفزعني"
    },
    {
      "id": 52,
      "start": 730.759,
      "end": 740.139,
      "text": "فامن علي بعفو منك يا أملي"
    },
    {
      "id": 53,
      "start": 740.139,
      "end": 749.959,
      "text": "فإنني موثق من ذنب مرتهني"
    },
    {
      "id": 54,
      "start": 749.959,
      "end": 758.959,
      "text": "تقاسم الأهل مالي بعد من صرفوا"
    },
    {
      "id": 55,
      "start": 758.959,
      "end": 767.119,
      "text": "وصار وزر على ظهري فأثقلني"
    },
    {
      "id": 56,
      "start": 767.119,
      "end": 777.079,
      "text": "واستبدلت زوجتي باعلا لها بدني"
    },
    {
      "id": 57,
      "start": 777.079,
      "end": 784.759,
      "text": "وحكمته على الأموال والسكن"
    },
    {
      "id": 58,
      "start": 784.759,
      "end": 802.959,
      "text": "وصيرت ولدي عبدا ليخدمه وصار مال لهم حلا بلا ثمن"
    },
    {
      "id": 59,
      "start": 802.959,
      "end": 823.199,
      "text": "فلا تغرنك الدنيا وزينتها وانظر إلى فعلها بالآل والوطني"
    },
    {
      "id": 60,
      "start": 823.199,
      "end": 832.599,
      "text": "وانظر إلى من حوى الدنيا بأجمعها"
    },
    {
      "id": 61,
      "start": 832.599,
      "end": 841.719,
      "text": "هل راح منها بظيل الحنط والكفني"
    },
    {
      "id": 62,
      "start": 841.719,
      "end": 850.079,
      "text": "خذ القناعة من دنياك وارض بها"
    },
    {
      "id": 63,
      "start": 850.079,
      "end": 858.399,
      "text": "لو لم يكن لك إلا راحة البدن"
    },
    {
      "id": 64,
      "start": 858.399,
      "end": 868.719,
      "text": "يا زارع الخير تحصد بعده ثمرا"
    },
    {
      "id": 65,
      "start": 868.719,
      "end": 878.559,
      "text": "يا زارع الشر موقوف على الوهن"
    },
    {
      "id": 66,
      "start": 878.559,
      "end": 887.339,
      "text": "يا نفس كف عن العصيان واكتسبي"
    },
    {
      "id": 67,
      "start": 887.339,
      "end": 896.919,
      "text": "فعلا جميلا لعل الله يرحمني"
    },
    {
      "id": 68,
      "start": 896.919,
      "end": 908.419,
      "text": "يا نفس ويحكي توبي وعملي حسنا"
    },
    {
      "id": 69,
      "start": 908.419,
      "end": 917.339,
      "text": "عسى تجازينا بعد الموت بالحسن"
    },
    {
      "id": 70,
      "start": 917.339,
      "end": 926.919,
      "text": "والحمد لله ممسينا ومصبحنا"
    },
    {
      "id": 71,
      "start": 926.919,
      "end": 936.339,
      "text": "ما وضأ البرق في شام وفي يمن"
    },
    {
      "id": 72,
      "start": 936.339,
      "end": 946.299,
      "text": "ثم الصلاة على المختار سيدنا"
    },
    {
      "id": 73,
      "start": 946.299,
      "end": 956.379,
      "text": "بالخير والعفو والإحسان والمينان"
    }
  ]
}