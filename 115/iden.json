{
  "type": "اناشيد",
  "name": "النفس تبكي على الدنيا",
  "verses": 13,
  "category": "أنشيدة",
  "generated_by": "groq_whisper",
  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 8.3,
      "text": "النفس تبكي على الدنيا وقد علمت"
    },
    {
      "id": 1,
      "start": 8.3,
      "end": 16.04,
      "text": "إن السلامة فيها ترك ما فيها"
    },
    {
      "id": 2,
      "start": 16.04,
      "end": 24.4,
      "text": "لا دار للمرء بعد الموت يسكنها"
    },
    {
      "id": 3,
      "start": 24.4,
      "end": 32.86,
      "text": "إلا التي كان قبل الموت بانيها"
    },
    {
      "id": 4,
      "start": 32.86,
      "end": 41.96,
      "text": "فإن بناها بخير طاب مسكنها"
    },
    {
      "id": 5,
      "start": 41.96,
      "end": 51.72,
      "text": "وإن بناها بشر خاب بانيها"
    },
    {
      "id": 6,
      "start": 51.72,
      "end": 59.86,
      "text": "أين الملوك التي كانت مسلطنة"
    },
    {
      "id": 7,
      "start": 59.86,
      "end": 68.36,
      "text": "حتى سقاها بكأس الموت ساقيها"
    },
    {
      "id": 8,
      "start": 85.96,
      "end": 97.44,
      "text": "كم من مدائنا في الأفاق قد بنيت"
    },
    {
      "id": 9,
      "start": 97.44,
      "end": 106.78,
      "text": "أمست خرابا ودان الموت دانيها"
    },
    {
      "id": 10,
      "start": 106.78,
      "end": 124.06,
      "text": "لكل نفس وإن كانت على وجل من المنية آمال تقويها"
    },
    {
      "id": 11,
      "start": 124.06,
      "end": 132.62,
      "text": "فالمرء يبسطها والدهر يقبضها"
    },
    {
      "id": 12,
      "start": 132.62,
      "end": 141.06,
      "text": "والنفس تنشرها والموت يطويها"
    }
  ]
}